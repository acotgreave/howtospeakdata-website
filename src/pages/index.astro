---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { site, feeds, href, formatDate, formatDateTime, pick, youtube } from '../lib/site';
import ContactForm from '../components/ContactForm.astro';
import headshot from '../assets/photos/headshot.jpg';

type Img = { default: ImageMetadata };
const photos = import.meta.glob<Img>('../assets/photos/*', { eager: true });
const heroImages = site.hero.images.slice(0, 3);

// A testimonial with a photo is shown large, first; the rest sit below it
const featuredQuote = site.testimonials.find((t: any) => t.photo);
const otherQuotes = site.testimonials.filter((t: any) => t !== featuredQuote);
const logos = import.meta.glob<Img>('../assets/logos/*', { eager: true });
const covers = import.meta.glob<Img>('../assets/books/*', { eager: true });

const { links } = site;
const oneSheet = href(links.one_sheet);
const bioPack = href(links.bio_pack);
---
<Base>
  <!-- Hero -->
  <section id="top" class:list={['hero', { 'hero--single': heroImages.length === 1 }]}>
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">{site.hero.eyebrow}</p>
        <h1 class="hero__h1">{site.hero.heading}</h1>
        <p class="hero__sub">{site.hero.sub}</p>
        <div class="btn-row">
          <a href="#contact" class="btn btn--lg btn--primary btn--on-dark">Get in touch</a>
          <a href={links.newsletter} target="_blank" rel="noopener" class="btn btn--lg btn--ghost">Get the newsletter</a>
        </div>
      </div>
      <div class:list={['hero__collage', `hero__collage--${heroImages.length}`]}>
        {heroImages.map((h: any, i: number) => {
          const zoom = h.zoom ?? 1;
          const pos = h.position ?? '50% 50%';
          const w = (heroImages.length === 1 ? 600 : i === 0 ? 300 : 250) * zoom;
          return (
            <figure class="hero__tile">
              <Picture
                src={pick(photos, h.image).default}
                alt={h.alt}
                formats={['avif', 'webp']}
                widths={[...new Set([1, 2, 3].map((x) => Math.min(Math.round(w * x), pick(photos, h.image).default.width)))]}
                sizes={`(max-width: 760px) ${Math.round((i === 0 ? 55 : 45) * zoom)}vw, ${Math.round(w)}px`}
                loading="eager"
                fetchpriority={i === 0 ? 'high' : undefined}
                style={`object-position: ${pos};` + (zoom !== 1 ? ` transform: scale(${zoom}); transform-origin: ${pos};` : '')}
              />
              {h.label && <figcaption class="hero__label">{h.label}</figcaption>}
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Stat strip -->
  <section class="stats" aria-label="At a glance">
    <div class="wrap stats__grid" style={`--stat-count: ${site.stats.length}`}>
      {site.stats.map((s: any) => (
        <div class="stat">
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 01 Speaking -->
  <section id="speaking" class="section">
    <div class="wrap">
      <div class="two-col">
        <div>
          <p class="eyebrow">01 — Speaking</p>
          <h2 class="h2 h2--lg">{site.speaking.heading}</h2>
          {site.speaking.paragraphs.map((p: string) => <p class="lede">{p}</p>)}
          <div class="btn-row speaking__ctas">
            <a href="#contact" class="btn btn--primary" data-enquiry-type="Keynote">Get in touch</a>
            {oneSheet && <a href={oneSheet} class="btn btn--outline" download>Download the speaker one-sheet</a>}
          </div>
        </div>
        <div class="topics">
          {site.speaking.topics.map((t: any, i: number) => {
            const Tag = t.url ? 'a' : 'div';
            return (
              <Tag href={t.url || undefined} class:list={['topic', { 'topic--link': t.url }]}>
                <span class="topic__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="topic__body">
                  <span class="topic__title">{t.title}</span>
                  <span class="topic__text">{t.text}</span>
                </span>
              </Tag>
            );
          })}
        </div>
      </div>

      <div class="carousel">
        <div class="carousel__track" role="region" aria-label="Speaking videos" tabindex="0">
          {site.speaking.videos.map((v: any) => {
            const yt = youtube(v.url);
            const style = v.position ? `object-position: ${v.position}` : undefined;
            return (
              <div class="carousel__slide">
                <a href={v.url} target="_blank" rel="noopener" class="video" data-youtube={yt.id} data-start={yt.start} data-title={v.title}>
                  <span class="video__play" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
                  </span>
                  {v.image
                    ? <Image src={pick(photos, v.image).default} alt={v.alt ?? v.title} widths={[600, 900, 1100]} sizes="(max-width: 760px) 86vw, 520px" style={style} />
                    : <img src={`https://i.ytimg.com/vi/${yt.id}/maxresdefault.jpg`} alt={v.alt ?? v.title} loading="lazy" style={style} />}
                  <span class="video__caption">
                    <span class="video__title">{v.title}</span>
                    <span class="video__sub">{v.caption}</span>
                  </span>
                </a>
              </div>
            );
          })}
        </div>
        <div class="carousel__controls">
          <button type="button" class="carousel__btn" data-dir="-1" aria-label="Previous videos">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="carousel__btn" data-dir="1" aria-label="Next videos">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Testimonials -->
  <section class="section section--alt section--testimonials">
    <div class="wrap">
      <p class="eyebrow eyebrow--spaced">02 — What organisers say</p>
      {featuredQuote && (
        <div class="quote-feature">
          <Image
            src={pick(photos, featuredQuote.photo).default}
            alt={featuredQuote.photo_alt ?? ''}
            widths={[600, 900, 1200]}
            sizes="(max-width: 760px) 100vw, 560px"
            class="quote-feature__photo"
            style={featuredQuote.photo_position ? `object-position: ${featuredQuote.photo_position}` : undefined}
          />
          <figure class="quote quote--large">
            <blockquote>{featuredQuote.quote}</blockquote>
            <figcaption>{featuredQuote.name}</figcaption>
          </figure>
        </div>
      )}
      <div class:list={[otherQuotes.length === 2 ? 'two-col two-col--tight' : 'three-col']}>
        {otherQuotes.map((t: any) => (
          <figure class="quote">
            <blockquote>{t.quote}</blockquote>
            <figcaption>{t.name}</figcaption>
          </figure>
        ))}
      </div>
      <div class="logos">
        <span class="logos__label">Spoken at</span>
        <div class="logos__row">
          {site.spoken_at.map((l: any) => {
            const img = pick(logos, l.file).default;
            return (
              <Image
                src={img}
                alt={l.alt}
                height={l.height}
                width={Math.round((img.width / img.height) * l.height)}
                densities={[1, 2]}
                style={`height: ${l.height}px`}
              />
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Latest content -->
  <section id="content" class="section">
    <div class="wrap">
      <p class="eyebrow">03 — Latest content</p>
      <h2 class="h2 content__h2">{site.content.heading}</h2>
      <div class="three-col three-col--wide">
        {site.content.streams.map((s: any) => {
          const items = feeds[s.key] ?? [];
          const soon = items.filter((i) => i.status);
          const aired = items.filter((i) => !i.status);
          // Video streams lead with the latest episode as a playable thumbnail
          const featured = aired[0]?.thumb ? aired[0] : undefined;
          const list = featured ? aired.slice(1, 5) : aired.slice(0, 5);
          return (
            <div class="card">
              <div class="card__head">
                <h3>{s.title}</h3>
                <p>{s.blurb} <a href={s.link.url} target="_blank" rel="noopener" class="card__link">{s.link.label}</a></p>
              </div>
              <div class="card__body">
              {soon.map((item) => (
                <a href={item.url} target="_blank" rel="noopener" class:list={['soon', { 'is-live': item.status === 'live' }]} data-start={item.date}>
                  <span class="soon__label">{item.status === 'live' ? 'Live now' : 'Coming up'}</span>
                  <span class="soon__title">{item.title}</span>
                  <time class="soon__when" datetime={item.date}>{formatDateTime(item.date)}</time>
                </a>
              ))}
              {featured && (
                <div class="feature">
                  <a href={featured.url} target="_blank" rel="noopener" class="video feature__media" data-youtube={youtube(featured.url).id || undefined} data-title={featured.title}>
                    {youtube(featured.url).id && (
                      <span class="video__play" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
                      </span>
                    )}
                    <img src={featured.thumb} alt="" loading="lazy" width="1280" height="720" />
                  </a>
                  <span class="feature__label">{youtube(featured.url).id ? 'Latest episode' : 'Latest post'}</span>
                  <a href={featured.url} target="_blank" rel="noopener" class="feature__title">{featured.title}</a>
                  <time datetime={featured.date}>{formatDate(featured.date)}</time>
                </div>
              )}
              <ul class="card__list">
                {list.map((item) => (
                  <li>
                    <a href={item.url} target="_blank" rel="noopener">{item.title}</a>
                    <time datetime={item.date}>{formatDate(item.date)}</time>
                  </li>
                ))}
              </ul>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 04 Books -->
  <section id="books" class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">04 — Books</p>
      {site.books_intro && <p class="lede books__intro">{site.books_intro}</p>}
      <div class="two-col two-col--tight">
        {site.books.map((b: any) => (
          <a href={b.url} target="_blank" rel="noopener" class="book">
            {b.cover
              ? <Image src={pick(covers, b.cover).default} alt={`${b.title} cover`} width={320} class="book__cover" />
              : <span class="book__cover book__cover--fallback" aria-hidden="true">{b.title}</span>}
            <span>
              <span class="book__title">{b.title}</span>
              <span class="book__text">{b.text}</span>
              <span class="book__link">{b.link_label}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 About -->
  <section id="about" class="section section--bordered">
    <div class="wrap about">
      <Image src={headshot} alt="Andy Cotgreave" width={900} class="about__photo" />
      <div>
        <p class="eyebrow">05 — Who I am</p>
        <h2 class="h2">{site.about.heading}</h2>
        {site.about.paragraphs.map((p: string) => <p class="lede about__p" set:html={p} />)}
        <div class="about__links">
          <a href={links.linkedin} target="_blank" rel="noopener">Follow on LinkedIn →</a>
          {bioPack && <a href={bioPack} download>Download bio and headshots →</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Get in touch -->
  <section id="contact" class="work">
    <div class="wrap work__inner">
      <div>
        <p class="eyebrow work__eyebrow">06 — Get in touch</p>
        <h2 class="h2 work__h2">{site.work.heading}</h2>
        <p class="work__text">{site.work.text}</p>
        <div class="work__alt">
          <p>Prefer to talk? <a href={links.book} target="_blank" rel="noopener">Book a 30-minute call →</a></p>
          <p class="work__email">
            Or email <span>{site.site.email}</span>
            <button type="button" class="work__copy" data-copy={site.site.email}>Copy</button>
          </p>
          <p class="work__news">Not planning an event? <a href={links.newsletter} target="_blank" rel="noopener">Get the newsletter →</a></p>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  // Swap a video card for the YouTube player on click. Nothing loads from
  // YouTube until then; without JS the card is a plain link to YouTube.
  document.querySelectorAll<HTMLAnchorElement>('.video[data-youtube]').forEach((card) => {
    const id = card.dataset.youtube;
    if (!id) return;
    card.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let "open in new tab" work
      e.preventDefault();
      const frame = document.createElement('div');
      frame.className = card.classList.contains('feature__media') ? 'video__frame video__frame--feature' : 'video__frame';
      const iframe = document.createElement('iframe');
      const start = card.dataset.start ? `&start=${card.dataset.start}` : '';
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0${start}`;
      iframe.title = card.dataset.title ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.append(iframe);
      card.replaceWith(frame);
      iframe.focus();
    });
  });

  // "Coming up" rows: show the start in the visitor's own timezone, and keep
  // the label honest between daily rebuilds.
  document.querySelectorAll<HTMLElement>('.soon[data-start]').forEach((row) => {
    const start = new Date(row.dataset.start!);
    const mins = (Date.now() - start.getTime()) / 60000;
    const label = row.querySelector('.soon__label')!;
    if (mins > 180) return row.remove(); // aired; it'll appear as an episode after the next feed update
    if (mins >= 0) {
      label.textContent = 'Live now';
      row.classList.add('is-live');
    }
    row.querySelector('.soon__when')!.textContent = start.toLocaleString(undefined, {
      weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
    });
  });

  // "Copy" next to the email address: works where mailto: links don't.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = btn.dataset.copy!; // clipboard blocked: show it to select by hand
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2500);
    });
  });

  // Carousel: native horizontal scroll (swipe/trackpad) plus prev/next buttons.
  document.querySelectorAll<HTMLElement>('.carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.carousel__track')!;
    const buttons = carousel.querySelectorAll<HTMLButtonElement>('.carousel__btn');
    const step = () => {
      const slide = track.querySelector<HTMLElement>('.carousel__slide');
      return slide ? slide.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      buttons[0].disabled = track.scrollLeft <= 2;
      buttons[1].disabled = track.scrollLeft >= max - 2;
      carousel.classList.toggle('is-static', max <= 2);
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' })),
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  /* Sections */
  .section { padding: 88px 0; background: var(--paper); }
  .section--alt { background: var(--paper-alt); border-top: 1px solid var(--hairline); }
  .section--bordered { border-top: 1px solid var(--hairline); }
  .section--testimonials { padding: 76px 0; border-bottom: 1px solid var(--hairline); }
  .eyebrow--spaced { margin-bottom: 34px; }
  .section--testimonials .eyebrow--spaced { margin-bottom: 30px; }
  .h2--lg { font-size: clamp(2rem, 3.2vw, 2.75rem); line-height: 1.08; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .two-col--tight { gap: 24px; }
  .three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .three-col--wide { gap: 24px; }

  /* Hero */
  .hero {
    background: linear-gradient(120deg, var(--ink) 0%, var(--navy) 62%);
    color: var(--white); overflow: hidden;
  }
  .hero__inner {
    display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 56px; align-items: center;
    padding-top: 80px; padding-bottom: 80px;
  }
  .hero__collage {
    display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: 1fr 1fr; gap: 12px;
    height: 500px;
  }
  .hero__tile { position: relative; margin: 0; border-radius: var(--radius-media); overflow: hidden; background: var(--ink); }
  .hero__tile:first-child { grid-row: span 2; }
  .hero__collage--2 .hero__tile { grid-row: span 2; }
  .hero__collage--1 { grid-template-columns: 1fr; grid-template-rows: auto; height: auto; }
  .hero__collage--1 .hero__tile { aspect-ratio: 16 / 10; }
  /* A single landscape photo gets the wider column so nothing important is cropped */
  .hero--single .hero__inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 48px; }
  .hero__tile :global(picture) { display: contents; }
  .hero__tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__label {
    position: absolute; z-index: 1; left: 12px; bottom: 12px; padding: 5px 10px; border-radius: 3px;
    background: rgba(11, 18, 32, 0.78); color: var(--white);
    font-family: var(--font-display); font-weight: 600; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .hero__eyebrow {
    font-family: var(--font-display); font-weight: 600; font-size: 13px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--sky-light); margin-bottom: 26px;
  }
  .hero__h1 {
    font-weight: 800; font-size: clamp(2.4rem, 4.2vw, 3.5rem); line-height: 1.04;
    letter-spacing: -0.025em; margin-bottom: 26px;
  }
  .hero__sub { font-size: 21px; line-height: 1.55; color: var(--pale-blue); max-width: 560px; margin-bottom: 40px; }

  /* Stats */
  .stats { background: var(--ink); border-top: 1px solid rgba(255,255,255,.09); }
  .stats__grid { padding-top: 26px; padding-bottom: 26px; display: grid; grid-template-columns: repeat(var(--stat-count, 4), 1fr); gap: 24px; }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat__value { font-family: var(--font-display); font-weight: 800; font-size: 26px; color: var(--white); line-height: 1; }
  .stat__label { font-size: 15px; color: var(--link-on-dark); }

  /* Speaking */
  .lede:last-of-type { margin-bottom: 34px; }
  .topics { display: flex; flex-direction: column; border-top: 1px solid var(--hairline); }
  .topic {
    display: flex; align-items: baseline; gap: 16px; padding: 20px 4px;
    border-bottom: 1px solid var(--hairline); color: inherit;
  }
  .topic--link:hover { background: var(--paper-alt); text-decoration: none; color: inherit; }
  .topic__num {
    font-family: var(--font-display); font-weight: 600; font-size: 12px; color: var(--muted);
    letter-spacing: 0.1em; width: 26px; flex-shrink: 0;
  }
  .topic__body { flex: 1; }
  .topic__title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--ink); margin-bottom: 4px; }
  .topic__text { display: block; font-size: 16px; color: var(--body); line-height: 1.5; }

  .carousel { margin-top: 56px; }
  .carousel__track {
    display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; overscroll-behavior-x: contain; scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }
  /* Two cards visible on desktop, with a sliver of the next one as a hint */
  .carousel__slide { flex: 0 0 calc((100% - 48px) / 2.12); scroll-snap-align: start; min-width: 0; }
  .carousel__controls { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
  .carousel.is-static .carousel__controls { display: none; }
  .carousel__btn {
    width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--navy); border-radius: 50%; background: transparent; color: var(--navy);
    transition: background-color .15s, color .15s;
  }
  .carousel__btn:hover:not(:disabled) { background: var(--navy); color: var(--white); }
  .carousel__btn:disabled { opacity: .3; cursor: default; }
  .video {
    position: relative; display: block; border-radius: var(--radius-media); overflow: hidden;
    border: 4px solid var(--navy);
  }
  .video:hover { text-decoration: none; }
  .video__play {
    position: absolute; top: 16px; left: 16px; z-index: 1;
    width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(11,18,32,.72); color: var(--white); border: 2px solid rgba(255,255,255,.85);
    transition: background-color .15s;
  }
  .video__play svg { margin-left: 3px; }
  .video:hover .video__play, .video:focus-visible .video__play { background: var(--accent); }
  :global(.video__frame) { position: relative; border-radius: var(--radius-media); overflow: hidden; border: 4px solid var(--navy); background: var(--ink); height: 328px; }
  :global(.video__frame iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .video :global(img) { width: 100%; height: 320px; object-fit: cover; display: block; }
  .video__caption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 22px 18px; display: block;
    background: linear-gradient(180deg, rgba(11,18,32,0) 0%, rgba(11,18,32,.9) 70%); color: var(--white);
  }
  .video__title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 19px; margin-bottom: 3px; }
  .video__sub { display: block; font-size: 15px; color: var(--pale-blue); }

  /* Testimonials */
  .quote {
    margin: 0; background: var(--white); border: 1px solid var(--hairline); border-radius: var(--radius);
    padding: 28px; display: flex; flex-direction: column;
  }
  .quote blockquote {
    margin: 0 0 22px; font-family: var(--font-display); font-weight: 600; font-size: 18px;
    line-height: 1.5; color: var(--ink); text-wrap: pretty;
  }
  .quote figcaption { font-size: 15px; color: var(--body); margin-top: auto; }
  .quote-feature {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); margin-bottom: 20px;
