---
import Base from '../layouts/Base.astro';
import { site, asset } from '../lib/site';
---
<Base title="Page not found · Andy Cotgreave" description="This page doesn't exist.">
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="h2">That page has gone off-script.</h1>
      <p class="lede">The link may be old, or the page may have moved. Here's where most people are heading:</p>
      <div class="btn-row">
        <a href={asset('')} class="btn btn--primary">Go to the homepage</a>
        <a href={asset('#speaking')} class="btn btn--outline">Keynote topics</a>
        <a href={site.links.newsletter} target="_blank" rel="noopener" class="btn btn--outline">Read the newsletter</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { padding: 120px 0 140px; }
  .notfound .lede { max-width: 560px; margin-bottom: 32px; }
  @media (max-width: 760px) { .notfound { padding: 72px 0 96px; } }
</style>
